#!/bin/sh
# Generated by reos.
set -u

sources=/target/etc/apt/sources.list
sources_dir=/target/etc/apt/sources.list.d
apt_config_dir=/target/etc/apt/apt.conf.d

if ! mkdir -p "$apt_config_dir"; then
    echo 'reos: Cannot create target APT configuration directory' >&2
    exit 1
fi
if ! cat >"$apt_config_dir/80reos-download-retries" <<'APTCONF'
Acquire::Retries "3";
Acquire::http::Timeout "30";
Acquire::https::Timeout "30";
APTCONF
then
    echo 'reos: Cannot write target APT download retry configuration' >&2
    exit 1
fi

if [ -f "$sources" ]; then
    grep -qF '{{.SecurityRepo}}' "$sources" && exit 0
    printf '%s\n' 'deb {{.SecurityRepo}} {{.SecuritySuite}} main' >>"$sources" || exit 0
elif ls "$sources_dir"/*.sources >/dev/null 2>&1; then
    if ! grep -qsF '{{.SecurityRepo}}' "$sources_dir"/*.sources; then
        mkdir -p "$sources_dir" || exit 0
        {
            echo 'Types: deb'
            echo 'URIs: {{.SecurityRepo}}'
            echo 'Suites: {{.SecuritySuite}}'
            echo 'Components: main'
        } >"$sources_dir/reos-early.sources" || exit 0
    fi
else
    echo 'reos: APT source configuration not found; skipping security repository preparation' >&2
    exit 0
fi

if ! chroot /target apt-get update >/dev/null 2>&1; then
    echo 'reos: Security repository refresh failed; continuing installation (pkgsel will retry upgrades)' >&2
fi
exit 0
