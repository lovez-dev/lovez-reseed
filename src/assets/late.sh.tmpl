#!/bin/sh
set -eu
TARGET=/target
ASSETS=/reos-assets

# Keep the selected hostname even when DHCP or reverse DNS supplied a name.
printf '%s\n' '{{.Hostname}}' > "$TARGET/etc/hostname"
sed -i '/^127\.0\.1\.1[[:space:]]/d' "$TARGET/etc/hosts"
printf '127.0.1.1\t%s\n' '{{.Hostname}}' >> "$TARGET/etc/hosts"

mkdir -p "$TARGET/root/.reos"
cp "$ASSETS/firstboot.sh" "$TARGET/root/.reos/firstboot.sh"
cp "$ASSETS/fix-eth-name.sh" "$TARGET/root/.reos/fix-eth-name.sh"
chmod 755 "$TARGET/root/.reos/fix-eth-name.sh"
mkdir -p "$TARGET/etc/systemd/system/multi-user.target.wants"
cp "$ASSETS/fix-eth-name.service" "$TARGET/etc/systemd/system/reos-fix-eth-name.service"
chmod 644 "$TARGET/etc/systemd/system/reos-fix-eth-name.service"
ln -sf /etc/systemd/system/reos-fix-eth-name.service \
    "$TARGET/etc/systemd/system/multi-user.target.wants/reos-fix-eth-name.service"
chmod 755 "$TARGET/root/.reos/firstboot.sh"
if [ -d "$ASSETS/optimize" ]; then
    mkdir -p "$TARGET/root/.reos/optimize"
    cp "$ASSETS"/optimize/*.sh "$TARGET/root/.reos/optimize/"
    chmod 755 "$TARGET/root/.reos/optimize/"*.sh
fi
if [ -x "$ASSETS/cleanup.sh" ]; then
    cp "$ASSETS/cleanup.sh" "$TARGET/root/.reos/cleanup.sh"
    chmod 755 "$TARGET/root/.reos/cleanup.sh"
fi

mkdir -p "$TARGET/etc/apt/apt.conf.d"
cat > "$TARGET/etc/apt/apt.conf.d/99-disable-kernel-protection" <<'APTCONF'
APT::Protect-Kernels "false";
APTCONF
{{if .Proxy}}
cat > "$TARGET/etc/apt/apt.conf.d/99reos-proxy" <<'APTPROXY'
Acquire::http::Proxy "{{.AptProxy}}";
Acquire::https::Proxy "{{.AptProxy}}";
APTPROXY
chmod 600 "$TARGET/etc/apt/apt.conf.d/99reos-proxy"
{{end}}{{if .Unattended}}
mkdir -p "$TARGET/etc/apt/apt.conf.d"
cat > "$TARGET/etc/apt/apt.conf.d/20auto-upgrades" <<'AUTOUPGRADE'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
APT::Periodic::AutocleanInterval "7";
AUTOUPGRADE
{{end}}{{if .NTP}}
if [ ! -e "$TARGET/usr/lib/systemd/system/systemd-timesyncd.service" ] &&
    [ ! -e "$TARGET/lib/systemd/system/systemd-timesyncd.service" ]; then
    if ! in-target env DEBIAN_FRONTEND=noninteractive \
        apt-get install -y systemd-timesyncd >/dev/null 2>&1; then
        echo "reos: systemd-timesyncd installation failed; NTP may not work" >&2
    fi
fi
mkdir -p "$TARGET/etc/systemd"
cat > "$TARGET/etc/systemd/timesyncd.conf" <<'TIMESYNC'
[Time]
NTP={{.NTP}}
TIMESYNC
in-target systemctl enable systemd-timesyncd >/dev/null 2>&1 || true
{{end}}
cat > "$TARGET/etc/systemd/system/reos-firstboot.service" <<'UNIT'
[Unit]
Description=One-time first-boot initialization
After=network.target network-online.target
Wants=network-online.target
ConditionPathExists=/root/.reos/firstboot.sh

[Service]
Type=oneshot
ExecStart=/root/.reos/firstboot.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
UNIT
mkdir -p "$TARGET/etc/systemd/system/multi-user.target.wants"
ln -sf /etc/systemd/system/reos-firstboot.service \
    "$TARGET/etc/systemd/system/multi-user.target.wants/reos-firstboot.service"

SSHD="$TARGET/etc/ssh/sshd_config"
if [ -f "$SSHD" ]; then
    sed -i -E 's/^#?Port .*/Port {{.SSHPort}}/' "$SSHD" || true
{{if eq .Username "root"}}    sed -i -E 's/^#?PermitRootLogin .*/PermitRootLogin yes/' "$SSHD" || true
{{else}}    sed -i -E 's/^#?PermitRootLogin .*/PermitRootLogin prohibit-password/' "$SSHD" || true
{{end}}{{if .AuthorizedKeys}}    sed -i -E 's/^#?PasswordAuthentication .*/PasswordAuthentication no/' "$SSHD" || true
{{end}}fi
{{if .AuthorizedKeys}}
mkdir -p "$TARGET{{.Home}}/.ssh"
chmod 700 "$TARGET{{.Home}}/.ssh"
in-target sh -c 'echo {{.KeysB64}} | base64 -d > {{.Home}}/.ssh/authorized_keys'
in-target chmod 600 {{.Home}}/.ssh/authorized_keys
{{if ne .Username "root"}}in-target chown -R {{.Username}}:{{.Username}} {{.Home}}/.ssh || true
{{end}}{{end}}{{if ne .Username "root"}}
printf '%s\n' '{{.Username}} ALL=(ALL:ALL) NOPASSWD:ALL' > "$TARGET/etc/sudoers.d/90-user-{{.Username}}"
chmod 440 "$TARGET/etc/sudoers.d/90-user-{{.Username}}"
{{end}}{{if .Interfaces}}
mkdir -p "$TARGET/etc/network"
cat > "$TARGET/etc/network/interfaces" <<'IFACES'
{{.Interfaces}}IFACES

if [ -f "$TARGET/etc/init.d/networking" ]; then
    in-target systemctl enable networking >/dev/null 2>&1 || true
fi
{{end}}{{if .ResolvConf}}
if [ ! -L "$TARGET/etc/resolv.conf" ]; then
cat > "$TARGET/etc/resolv.conf" <<'RESOLV'
{{.ResolvConf}}RESOLV
fi
{{end}}{{if .KeepFstab}}
cat >> "$TARGET/etc/fstab" <<'FSTAB'
{{range .KeepFstab}}PARTUUID={{.PartUUID}} {{.MountPoint}} {{.FSType}} defaults,nofail 0 {{.Pass}}
{{end}}FSTAB
{{range .KeepFstab}}mkdir -p "$TARGET{{.MountPoint}}"
{{end}}{{end}}if ! in-target env DEBIAN_FRONTEND=noninteractive apt-get autoremove --purge -y; then
    echo "reos: installation cleanup failed; it will be retried on first boot" >&2
fi

exit 0
