#!/bin/sh
# Generated by reos.
set -u

PORT={{.SSHPort}}
USER_NAME={{.Username}}
PASS_FILE=/configs/reos-installer-pass
KEYS_FILE=/configs/reos-installer-keys

supervise() {
    mkdir /run/reos-sshd.lock 2>/dev/null || exit 0
    while :; do
        /usr/sbin/sshd -D -e -p "$PORT" >>/var/log/reos-installer-ssh.log 2>&1
        sleep 5
    done
}

if [ "${1:-}" = "--supervise" ]; then
    supervise
    exit 0
fi

mkdir -p /etc/ssh /run/sshd /var/log
chmod 0755 /run/sshd

grep -qs '^sshd:' /etc/passwd ||
    echo 'sshd:*:100:65534::/run/sshd:/bin/false' >>/etc/passwd
grep -qs '^sshd:' /etc/group ||
    echo 'sshd:*:65534:' >>/etc/group

hash=$(cat "$PASS_FILE" 2>/dev/null || true)
ROOT_SHELL=0

ensure_account() {
    name=$1
    uid=$2
    home=$3
    grep -qs "^$name:" /etc/passwd ||
        echo "$name:*:$uid:$uid:$name:$home:/bin/sh" >>/etc/passwd
    grep -qs "^$name:" /etc/group ||
        echo "$name:*:$uid:" >>/etc/group
    if [ -n "$hash" ]; then
        if grep -qs "^$name:" /etc/shadow; then
            sed -i "s#^$name:[^:]*:#$name:$hash:#" /etc/shadow
        else
            echo "$name:$hash:19000:0:99999:7:::" >>/etc/shadow
        fi
    fi
    mkdir -p "$home"
}

if [ "$USER_NAME" = root ]; then
    ensure_account root 0 /
else
    ensure_account "$USER_NAME" 1000 "/home/$USER_NAME"
    chown 1000:1000 "/home/$USER_NAME" 2>/dev/null || true
    # The installer has no sudo package; expose a separate root shell through screen.
    if command -v screen >/dev/null 2>&1 && [ -x /usr/bin/screen ]; then
        screen -dmS reos-admin /bin/sh -c 'while :; do /bin/sh -i; sleep 1; done' >/dev/null 2>&1 || true
        attempt=0
        while [ "$attempt" -lt 5 ]; do
            if screen -S reos-admin -X multiuser on >/dev/null 2>&1 &&
                screen -S reos-admin -X acladd "$USER_NAME" >/dev/null 2>&1; then
                chmod 4755 /usr/bin/screen && ROOT_SHELL=1
                break
            fi
            attempt=$((attempt + 1))
            sleep 1
        done
    fi
fi

if [ -s "$KEYS_FILE" ]; then
    if [ "$USER_NAME" = root ]; then
        home=/
    else
        home="/home/$USER_NAME"
    fi
    mkdir -p "$home/.ssh"
    chmod 700 "$home/.ssh"
    cat "$KEYS_FILE" >"$home/.ssh/authorized_keys"
    chmod 600 "$home/.ssh/authorized_keys"
    if [ "$USER_NAME" != root ]; then
        chown -R 1000:1000 "$home/.ssh" 2>/dev/null || true
    fi
fi

if [ "$USER_NAME" = root ]; then
    root_login=yes
else
    root_login=prohibit-password
fi
if [ -s "$KEYS_FILE" ]; then
    password_auth=no
else
    password_auth=yes
fi

cat >/etc/ssh/sshd_config <<EOF
Port $PORT
PermitRootLogin $root_login
PasswordAuthentication $password_auth
KbdInteractiveAuthentication no
UseDNS no
PrintMotd yes
EOF

cat >/etc/motd <<'EOF'
========================================
 reos: Debian installer environment

 View installer logs:
   tail -fn+1 /var/log/syslog

 View kernel logs:
   dmesg -w

EOF

if [ -n "${STY:-}" ] && [ -x /usr/bin/screen ]; then
    if screen -X multiuser on 2>/dev/null; then
        if [ "$USER_NAME" = root ]; then
            attach="TERM=screen screen -x $STY"
        else
            chmod +s /usr/bin/screen 2>/dev/null || true
            screen -X acladd "$USER_NAME" 2>/dev/null || true
            attach="TERM=screen screen -x root/$STY"
        fi
        printf ' Attach to the installer (shared with the local console):\n   %s\n\n' "$attach" >>/etc/motd
    fi
fi

if [ "$USER_NAME" = root ]; then
    cat >>/etc/motd <<'EOF'
 Installer SSH is already root; no sudo command is needed.

EOF
elif [ "$ROOT_SHELL" -eq 1 ]; then
    cat >>/etc/motd <<'EOF'
 Open a privileged installer shell:
   TERM=screen screen -x root/reos-admin

EOF
else
    cat >>/etc/motd <<'EOF'
 A privileged installer shell is unavailable in this session.

EOF
fi

cat >>/etc/motd <<'EOF'
 This session will disconnect and the machine will reboot after installation.
========================================
EOF

ssh-keygen -A >/dev/null 2>&1 || true

if ! { command -v screen >/dev/null 2>&1 &&
    screen -dmS reos-sshd sh /reos-assets/installer-ssh.sh --supervise 2>/dev/null; }; then
    if command -v nohup >/dev/null 2>&1; then
        nohup sh /reos-assets/installer-ssh.sh --supervise >>/var/log/reos-installer-ssh.log 2>&1 &
    else
        (sh /reos-assets/installer-ssh.sh --supervise >>/var/log/reos-installer-ssh.log 2>&1 &)
    fi
fi

exit 0
